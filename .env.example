# Copy to .env and fill only credentials you have explicitly authorized.
TZ=Asia/Seoul
JOB_ASSIST_DATA_DIR=./data
JOB_ASSIST_LOG_DIR=./logs

# Google Workspace OAuth or service-account setup is documented in docs/GOOGLE_WORKSPACE_SETUP.md.
GOOGLE_SHEET_ID=
GOOGLE_SHEET_TAB=전체공고
GOOGLE_DRIVE_PARENT_ID=
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_OAUTH_CLIENT_SECRETS=
GOOGLE_OAUTH_TOKEN_FILE=./data/google-token.json
GOOGLE_RESUME_DOC_ID=

# GPT scoring and document drafting. Hermes can also score through its own configured model;
# in that mode it calls the CLI import command with the generated evaluation JSON.
OPENAI_API_KEY=
OPENAI_MODEL=
MINIMUM_SCORE=70

# Saramin is enabled only after its official API application is approved and a key is issued.
SARAMIN_API_APPROVED=false
SARAMIN_ACCESS_KEY=
SARAMIN_LOCATION_CODES=

# Telegram uses a bot token and an allow-listed chat/user ID.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# All application actions start in draft-only mode.
AUTO_SUBMIT=false
FORM_AUTOFILL_ENABLED=false
SUBMISSION_APPROVAL_FILE=./data/platform-submit-approvals.json
